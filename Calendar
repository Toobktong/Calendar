                logEntry.classList.add('log-entry');
                logEntry.innerHTML = `<span class="log-timestamp">${log.timestamp}</span>: <span class="log-action">${log.action}</span> <br> <small>(${log.userAgent})</small>`;
                logContent.appendChild(logEntry);
            });
        }
        
        // สร้าง options สำหรับปีใน report modal
