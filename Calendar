    <script>
        // *** ค่าคงที่สำหรับการตั้งค่า ***
        const REPORT_PASSWORD = '1234'; // รหัสผ่านสำหรับเข้าถึงรายงาน (ควรเปลี่ยน/ซ่อนใน Production)
        const SETTINGS_PASSWORD = '4321'; // รหัสผ่านสำหรับเข้าถึง Log (ควรเปลี่ยน/ซ่อนใน Production)
        const LOCAL_STORAGE_NOTES_KEY = 'auditor_schedule_notes';
        const LOCAL_STORAGE_LOGS_KEY = 'auditor_schedule_logs';

        // *** การโหลด/บันทึกข้อมูลด้วย Local Storage ***

        // โหลดข้อมูล Note จาก Local Storage
        function loadNotes() {
            try {
                const notesData = localStorage.getItem(LOCAL_STORAGE_NOTES_KEY);
                return notesData ? JSON.parse(notesData) : {};
            } catch (e) {
                console.error("Error loading notes from localStorage", e);
                return {};
            }
        }

        // บันทึกข้อมูล Note ไปยัง Local Storage
        function saveNotes() {
            try {
                localStorage.setItem(LOCAL_STORAGE_NOTES_KEY, JSON.stringify(notes));
            } catch (e) {
                console.error("Error saving notes to localStorage", e);
            }
        }

        // โหลดข้อมูล Log จาก Local Storage
        function loadLogs() {
            try {
                const logsData = localStorage.getItem(LOCAL_STORAGE_LOGS_KEY);
                return logsData ? JSON.parse(logsData) : [];
            } catch (e) {
                console.error("Error loading logs from localStorage", e);
                return [];
            }
        }

        // บันทึกข้อมูล Log ไปยัง Local Storage
        function saveLogs() {
            try {
                localStorage.setItem(LOCAL_STORAGE_LOGS_KEY, JSON.stringify(logs));
            } catch (e) {
                console.error("Error saving logs to localStorage", e);
            }
        }

        // ฟังก์ชันเพิ่ม log
        function addLog(action) {
            const now = new Date();
            const timestamp = now.toLocaleString('th-TH', {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit'
            });

            // ดึง User Agent
            const userAgent = navigator.userAgent;

            logs.push({ 
                timestamp, 
                action, 
                userAgent,
                id: logs.length + 1
            });
            saveLogs();
        }


        // *** การตั้งค่าเริ่มต้นและตัวแปร ***
        let currentDate = new Date();
        let currentMonth = currentDate.getMonth();
        let currentYear = currentDate.getFullYear();
        let selectedDateForNote = null;
        let notes = loadNotes(); // โหลด Note เมื่อเริ่มต้น
        let logs = loadLogs();   // โหลด Log เมื่อเริ่มต้น

        // ชื่อเดือนภาษาไทย
        const thaiMonths = [
            'มกราคม', 'กุมภาพันธ์', 'มีนาคม', 'เมษายน', 'พฤษภาคม', 'มิถุนายน',
            'กรกฎาคม', 'สิงหาคม', 'กันยายน', 'ตุลาคม', 'พฤศจิกายน', 'ธันวาคม'
        ];

        // ชื่อวันภาษาไทย
        const thaiDays = ['อา', 'จ', 'อ', 'พ', 'พฤ', 'ศ', 'ส'];
        
        // วันหยุดราชการ (ควรดึงจาก API ภายนอกในการใช้งานจริง แต่ใช้ Static Data สำหรับ Deploy)
        const regularHolidays = {
            '2025-01-01': 'วันขึ้นปีใหม่', '2025-02-03': 'วันมาฆบูชา', '2025-04-06': 'วันจักรี',
            '2025-04-13': 'วันสงกรานต์', '2025-04-14': 'วันสงกรานต์', '2025-04-15': 'วันสงกรานต์',
            '2025-05-01': 'วันแรงงานแห่งชาติ', '2025-05-05': 'วันฉัตรมงคล', '2025-05-19': 'วันพืชมงคล',
            '2025-06-02': 'วันเฉลิมพระชนมพรรษา (ร.10)', '2025-07-28': 'วันเฉลิมพระชนมพรรษา (ราชินี)',
            '2025-08-12': 'วันแม่', '2025-10-13': 'วันคล้ายวันสวรรคต ร.9', '2025-10-23': 'วันปิยมหาราช',
            '2025-12-05': 'วันพ่อ', '2025-12-10': 'วันรัฐธรรมนูญ', '2025-12-31': 'วันสิ้นปี'
        };

        const specialHolidays = {
             // ตัวอย่างวันหยุดเฉพาะกิจเพิ่มเติม 
        };
        
        function isHoliday(dateKey) {
            return regularHolidays[dateKey] || specialHolidays[dateKey];
        }


        // *** ฟังก์ชันปฏิทิน ***
        
        // ฟังก์ชันสร้างปฏิทิน
        function generateCalendar(month, year) {
            fullCalendarGrid.innerHTML = ''; // Clear existing days
            
            // Re-add day headers
            thaiDays.forEach(day => {
                const dayHeader = document.createElement('div');
                dayHeader.classList.add('full-calendar-header-day');
                dayHeader.textContent = day;
                fullCalendarGrid.appendChild(dayHeader);
            });

            // หาข้อมูลของเดือน
            const firstDayOfMonth = new Date(year, month, 1);
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            const lastDayOfPreviousMonth = new Date(year, month, 0).getDate();
            
            // หาตำแหน่งเริ่มต้นของวันแรก (0=อาทิตย์, 1=จันทร์, ...)
            let startDayIndex = firstDayOfMonth.getDay(); 

            // อัปเดตชื่อเดือนและปีที่แสดง
            currentMonthElement.textContent = `${thaiMonths[month]} ${year}`;

            let dateCounter = 1;
            const today = new Date();
            const todayKey = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;


            // 1. วันที่ของเดือนก่อนหน้า
            for (let i = 0; i < startDayIndex; i++) {
                const dayDiv = document.createElement('div');
                dayDiv.classList.add('full-calendar-day', 'other-month');
                const dateNum = lastDayOfPreviousMonth - startDayIndex + i + 1;
                dayDiv.innerHTML = `<span class="day-date">${dateNum}</span>`;
                fullCalendarGrid.appendChild(dayDiv);
            }

            // 2. วันที่ของเดือนปัจจุบัน
            for (let i = 1; i <= daysInMonth; i++) {
                const dayDiv = document.createElement('div');
                dayDiv.classList.add('full-calendar-day');
                
                const dayOfWeek = (startDayIndex + i - 1) % 7; // 0=อาทิตย์, 6=เสาร์
                
                // สร้าง Date Key ในรูปแบบ YYYY-MM-DD
                const dateKey = `${year}-${String(month + 1).padStart(2, '0')}-${String(i).padStart(2, '0')}`;
                
                dayDiv.dataset.dateKey = dateKey;
                
                // ตรวจสอบวันหยุด
                const holidayName = isHoliday(dateKey);
                if (holidayName) {
                    dayDiv.classList.add('holiday');
                }
                
                // ตรวจสอบวันนี้
                if (dateKey === todayKey) {
                    dayDiv.classList.add('today');
                }
                
                // ตรวจสอบวันเสาร์อาทิตย์
                 if (dayOfWeek === 0) {
                    dayDiv.classList.add('sunday');
                } else if (dayOfWeek === 6) {
                    dayDiv.classList.add('saturday');
                }


                // เพิ่มวันที่
                dayDiv.innerHTML = `<span class="day-date">${i}</span>`;
                
                // เพิ่มเครื่องหมายวันหยุด
                if (holidayName) {
                    dayDiv.innerHTML += `<span class="holiday-mark">${holidayName}</span>`;
                }

                // แสดง Note Preview
                if (notes[dateKey] && notes[dateKey].trim() !== '') {
                    dayDiv.classList.add('has-note');
                    dayDiv.innerHTML += `<span class="note-preview"><i class="fas fa-pencil-alt"></i> ${notes[dateKey].substring(0, 20)}...</span>`;
                }
                
                // เพิ่ม Event Listener เพื่อเปิด Note Modal
                dayDiv.addEventListener('click', function() {
                    if (!this.classList.contains('other-month')) {
                        openNoteModal(dateKey);
                    }
                });


                fullCalendarGrid.appendChild(dayDiv);
                dateCounter++;
            }

            // 3. วันที่ของเดือนถัดไป (เติมให้ครบ 6 แถว หากจำเป็น)
            let nextMonthDay = 1;
            const totalDaysRendered = startDayIndex + daysInMonth;
            const remainingDays = 42 - totalDaysRendered; // เผื่อกรณี 6 แถว (6x7=42)
            const requiredDays = totalDaysRendered <= 35 ? (35 - totalDaysRendered) : (42 - totalDaysRendered);


            for (let i = 0; i < requiredDays; i++) {
                const dayDiv = document.createElement('div');
                dayDiv.classList.add('full-calendar-day', 'other-month');
                dayDiv.innerHTML = `<span class="day-date">${nextMonthDay}</span>`;
                fullCalendarGrid.appendChild(dayDiv);
                nextMonthDay++;
            }
        }
        
        // ฟังก์ชันเปลี่ยนเดือน
        function changeMonth(direction) {
            currentMonth += direction;
            if (currentMonth > 11) {
                currentMonth = 0;
                currentYear++;
            } else if (currentMonth < 0) {
                currentMonth = 11;
                currentYear--;
            }
            generateCalendar(currentMonth, currentYear);
        }

