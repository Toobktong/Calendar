        // ฟังก์ชันคำนวณขนาดข้อมูล (ประมาณการ)
        function calculateStorageSize() {
            // ประมาณขนาดข้อมูล (เป็นตัวอักษร)
            const logsString = JSON.stringify(logs);
            const notesString = JSON.stringify(notes);
            const totalSize = (logsString.length + notesString.length) * 2; // *2 เพื่อแปลงเป็นไบต์ (คร่าวๆ)

            const sizeInKB = (totalSize / 1024).toFixed(2);
            return {
                size: totalSize,
                sizeInKB: sizeInKB
            };
        }
        
        // ฟังก์ชันอัปเดตสถิติ
        function updateLogStats() {
            totalLogsElement.textContent = logs.length;
            
            const storageInfo = calculateStorageSize();
            storageSizeElement.textContent = `${storageInfo.sizeInKB} KB`;
            
            totalNotes.textContent = Object.keys(notes).length;
        }
        
