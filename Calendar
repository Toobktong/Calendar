<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบจัดการตารางเวลาสำหรับ Auditor</title>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&family=TH+Sarabun+PSK:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* CSS ทั้งหมดตามเดิม */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Prompt', 'TH Sarabun PSK', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        header {
            text-align: center;
            padding: 40px 20px;
            color: white;
        }

        h1 {
            font-size: 2.8rem;
            margin-bottom: 15px;
            text-shadow: 0 2px 4px rgba(0,0,0,0.2);
        }

        .subtitle {
            font-size: 1.3rem;
            opacity: 0.9;
            max-width: 700px;
            margin: 0 auto;
            line-height: 1.6;
        }

        /* Navigation Menu */
        .navbar {
            background: rgba(255,255,255,0.15);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            padding: 15px 20px;
            margin: 20px 0;
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .nav-item {
            color: white;
            padding: 12px 25px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
            cursor: pointer;
            border: 2px solid transparent;
            font-size: 1.1rem;
        }

        .nav-item:hover {
            background: rgba(255,255,255,0.2);
            transform: translateY(-2px);
        }

        .nav-item.active {
            background: white;
            color: #667eea;
            font-weight: 600;
        }
        
        /* Tab Content Containers */
        .tab-content {
            display: none;
        }

        .calendar-full {
            background: white;
            border-radius: 15px;
            padding: 40px;
            margin-top: 50px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            display: block; /* Default tab */
        }

        .calendar-full h2 {
            color: #333;
            margin-bottom: 30px;
            font-size: 2.2rem;
            text-align: center;
        }

        .full-calendar {
            margin-top: 20px;
        }

        .full-calendar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .month-navigation {
            display: flex;
            gap: 15px;
            align-items: center;
        }

        .nav-btn {
            background: #667eea;
            color: white;
            border: none;
            padding: 10px 15px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1rem;
            font-family: 'Prompt', 'TH Sarabun PSK', sans-serif;
            transition: background 0.2s ease;
        }
        
        .nav-btn:hover {
            background: #5a6edb;
        }
        
        .nav-btn:active {
             background: #4d5ecd;
        }

        .current-month {
            font-size: 1.5rem;
            font-weight: 600;
            color: #333;
        }

        .full-calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 5px;
        }

        .full-calendar-header-day {
            background: #667eea;
            color: white;
            padding: 15px;
            text-align: center;
            font-weight: 600;
            border-radius: 5px;
        }

        .full-calendar-day {
            background: #f8f9fa;
            padding: 15px 5px 5px 5px; /* ปรับ padding ด้านบนให้น้อยลงเพื่อแสดงวันที่ */
            min-height: 80px;
            border-radius: 5px;
            border: 1px solid #e9ecef;
            cursor: pointer;
            transition: all 0.2s ease;
            position: relative;
            text-align: left; /* ปรับการจัดวางข้อความในวัน */
        }

        .full-calendar-day:hover {
            background: #e3f2fd;
            border-color: #667eea;
        }

        .full-calendar-day.other-month {
            background: #f0f0f0;
            color: #999;
            cursor: default;
        }
        
        .full-calendar-day.other-month:hover {
            background: #f0f0f0;
            border-color: #e9ecef;
        }

        .full-calendar-day.today {
            background: #fff3e0; /* สีส้มอ่อนสำหรับวันนี้ */
            border: 2px solid #ff9800; /* ขอบส้มสำหรับวันนี้ */
        }
        
        .full-calendar-day.sunday, .full-calendar-day.saturday {
            /* สีสำหรับวันเสาร์-อาทิตย์ */
            background: #fde8e9; 
        }

        .full-calendar-day.holiday {
            background: #ffebee;
            border-color: #f44336;
        }
        
        .full-calendar-day.has-note {
             /* สีเน้นวันที่ที่มี Note */
            border: 2px solid #764ba2;
            box-shadow: 0 0 5px rgba(118, 75, 162, 0.5);
        }


        .day-date {
            font-weight: 600;
            margin-bottom: 5px;
            display: block;
            text-align: center;
            font-size: 1.2rem;
        }
        
        .full-calendar-day.holiday .day-date {
            color: #f44336;
        }
        
        .full-calendar-day.sunday .day-date, .full-calendar-day.saturday .day-date {
            color: #f44336;
        }

        .event-dot {
            width: 8px;
            height: 8px;
            background: #667eea;
            border-radius: 50%;
            display: inline-block;
            margin: 2px;
        }

        .holiday-mark {
            background: #f44336;
            color: white;
            padding: 2px 6px;
            border-radius: 10px;
            font-size: 0.7rem;
            display: block; /* แสดงเป็นบล็อกเพื่อให้ขึ้นบรรทัดใหม่ */
            margin-top: 5px;
            text-align: center;
            font-weight: 500;
            line-height: 1;
        }
        
        .note-preview {
            font-size: 0.75rem;
            color: #666;
            margin-top: 5px;
            max-height: 30px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            display: block;
            padding: 0 5px;
        }
        
        /* สไตล์เดิมที่เหลือ */
        .day-events {
            font-size: 0.7rem;
            color: #666;
            margin-top: 3px;
            max-height: 30px;
            overflow: hidden;
        }

        footer {
            text-align: center;
            color: white;
            padding: 40px 20px;
            margin-top: 50px;
            font-size: 1.1rem;
        }

        /* Modal Styles */
        /* ... (Modal CSS codes are kept as is) ... */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.8);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background: white;
            border-radius: 15px;
            width: 90%;
            max-width: 1000px;
            max-height: 90vh;
            overflow: auto;
            position: relative;
            padding: 30px;
        }

        .close-modal {
            position: absolute;
            top: 20px;
            right: 20px;
            font-size: 2rem;
            cursor: pointer;
            color: #666;
            background: none;
            border: none;
        }

        .close-modal:hover {
            color: #f44336;
        }

        /* Note Modal */
        .note-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.8);
            z-index: 1100;
            justify-content: center;
            align-items: center;
        }

        .note-modal-content {
            background: white;
            border-radius: 15px;
            width: 90%;
            max-width: 500px;
            padding: 30px;
            position: relative;
        }

        .note-modal-header {
            margin-bottom: 20px;
        }

        .note-modal-header h3 {
            color: #333;
            font-size: 1.5rem;
        }

        .selected-date {
            color: #667eea;
            font-weight: 600;
        }

        .note-textarea {
            width: 100%;
            height: 150px;
            padding: 15px;
            border: 2px solid #e9ecef;
            border-radius: 10px;
            font-size: 1rem;
            resize: vertical;
            margin-bottom: 20px;
            font-family: 'Prompt', 'TH Sarabun PSK', sans-serif;
        }

        .note-textarea:focus {
            outline: none;
            border-color: #667eea;
        }

        .note-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .cancel-btn {
            background: #f5f5f5;
            color: #666;
            padding: 12px 25px;
            border-radius: 50px;
            border: none;
            cursor: pointer;
            font-weight: 600;
            font-family: 'Prompt', 'TH Sarabun PSK', sans-serif;
            transition: background 0.2s;
        }
        
        .cancel-btn:hover {
             background: #e0e0e0;
        }

        .save-note-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 12px 25px;
            border-radius: 50px;
            border: none;
            cursor: pointer;
            font-weight: 600;
            font-family: 'Prompt', 'TH Sarabun PSK', sans-serif;
            transition: opacity 0.2s;
        }
        
        .save-note-btn:hover {
            opacity: 0.9;
        }

        /* Report Password Modal */
        .report-password-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.8);
            z-index: 1200;
            justify-content: center;
            align-items: center;
        }

        .report-password-modal-content {
            background: white;
            border-radius: 15px;
            width: 90%;
            max-width: 600px;
            padding: 30px;
            position: relative;
        }

        .report-password-modal-header {
            margin-bottom: 20px;
        }

        .report-password-modal-header h3 {
            color: #333;
            font-size: 1.5rem;
        }

        .password-form {
            margin-bottom: 20px;
        }

        .password-input {
            width: 100%;
            padding: 12px;
            border: 2px solid #e9ecef;
            border-radius: 10px;
            font-size: 1rem;
            font-family: 'Prompt', 'TH Sarabun PSK', sans-serif;
            text-align: center;
            letter-spacing: 5px;
        }

        .password-input:focus {
            outline: none;
            border-color: #667eea;
        }

        .report-password-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }
        
        .btn { /* ใช้สำหรับปุ่มยืนยันใน Modal รหัสผ่าน */
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 12px 25px;
            border-radius: 50px;
            border: none;
            cursor: pointer;
            font-weight: 600;
            font-family: 'Prompt', 'TH Sarabun PSK', sans-serif;
            transition: opacity 0.2s;
        }
        
        .btn:hover {
            opacity: 0.9;
        }

        /* Report Modal */
        .report-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.8);
            z-index: 1300;
            justify-content: center;
            align-items: center;
        }

        .report-modal-content {
            background: white;
            border-radius: 15px;
            width: 90%;
            max-width: 600px;
            padding: 30px;
            position: relative;
        }

        .report-modal-header {
            margin-bottom: 20px;
        }

        .report-modal-header h3 {
            color: #333;
            font-size: 1.5rem;
        }

        .report-form {
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
            color: #333;
        }

        .form-control {
            width: 100%;
            padding: 12px;
            border: 2px solid #e9ecef;
            border-radius: 10px;
            font-size: 1rem;
            font-family: 'Prompt', 'TH Sarabun PSK', sans-serif;
            background: white;
        }

        .form-control:focus {
            outline: none;
            border-color: #667eea;
        }

        .report-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .download-btn {
            background: linear-gradient(135deg, #4CAF50 0%, #2E7D32 100%);
            color: white;
            padding: 12px 25px;
            border-radius: 50px;
            border: none;
            cursor: pointer;
            font-weight: 600;
            font-family: 'Prompt', 'TH Sarabun PSK', sans-serif;
            transition: opacity 0.2s;
        }
        
        .download-btn:hover {
            opacity: 0.9;
        }

        /* Settings Modal */
        .settings-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.8);
            z-index: 1400;
            justify-content: center;
            align-items: center;
        }

        .settings-modal-content {
            background: white;
            border-radius: 15px;
            width: 90%;
            max-width: 600px;
            padding: 30px;
            position: relative;
        }

        .settings-modal-header {
            margin-bottom: 20px;
        }

        .settings-modal-header h3 {
            color: #333;
            font-size: 1.5rem;
        }

        .settings-password-form {
            margin-bottom: 20px;
        }

        .settings-password-input {
            width: 100%;
            padding: 12px;
            border: 2px solid #e9ecef;
            border-radius: 10px;
            font-size: 1rem;
            font-family: 'Prompt', 'TH Sarabun PSK', sans-serif;
            text-align: center;
            letter-spacing: 5px;
        }

        .settings-password-input:focus {
            outline: none;
            border-color: #667eea;
        }

        .settings-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        /* Log Modal */
        .log-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.8);
            z-index: 1500;
            justify-content: center;
            align-items: center;
        }

        .log-modal-content {
            background: white;
            border-radius: 15px;
            width: 90%;
            max-width: 800px;
            max-height: 80vh;
            padding: 30px;
            position: relative;
            overflow: hidden;
        }

        .log-modal-header {
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .log-modal-header h3 {
            color: #333;
            font-size: 1.5rem;
        }

        .log-content {
            max-height: 60vh;
            overflow-y: auto;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 10px;
            font-family: monospace;
            font-size: 0.9rem;
        }

        .log-entry {
            margin-bottom: 10px;
            padding: 10px;
            border-bottom: 1px solid #eee;
            word-wrap: break-word; /* เพื่อให้ข้อความยาวๆ ไม่ล้นออกไป */
        }

        .log-entry:last-child {
            border-bottom: none;
        }

        .log-timestamp {
            color: #667eea;
            font-weight: bold;
        }

        .log-action {
            color: #333;
        }

        .log-stats {
            background: #e3f2fd;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 20px;
            font-size: 0.9rem;
        }

        .log-stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 15px;
            margin-top: 10px;
        }

        .stat-item {
            background: white;
            padding: 10px;
            border-radius: 5px;
            text-align: center;
        }

        .stat-value {
            font-size: 1.2rem;
            font-weight: bold;
            color: #667eea;
        }

        .stat-label {
            font-size: 0.9rem;
            color: #666;
        }

        @media (max-width: 768px) {
            h1 {
                font-size: 2.2rem;
            }
            
            .subtitle {
                font-size: 1.1rem;
            }
            
            .navbar {
                flex-direction: column;
                align-items: center;
            }
            
            .nav-item {
                width: 90%;
                text-align: center;
            }
            
            .full-calendar-grid {
                grid-template-columns: repeat(7, 1fr);
                gap: 3px;
            }
            
            .full-calendar-day {
                padding: 8px;
                min-height: 60px;
                font-size: 0.9rem;
            }
            
            .full-calendar-header-day {
                padding: 10px 5px;
            }
            
            .day-date {
                font-size: 1rem;
            }
        }

        @media (max-width: 480px) {
            .full-calendar-grid {
                grid-template-columns: repeat(7, 1fr);
                gap: 2px;
            }
            
            .full-calendar-day {
                padding: 5px;
                min-height: 50px;
                font-size: 0.8rem;
            }
            
            .day-date {
                font-size: 0.9rem;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>ระบบจัดการตารางเวลาสำหรับ Auditor</h1>
            <p class="subtitle">ใช้ Local Storage (สำหรับการ Deploy แบบ Static) เพื่อให้ Auditor สามารถบล็อกเวลาที่ไม่สะดวกและบันทึก Note ได้</p>
        </header>

        <div class="navbar">
            <div class="nav-item active" data-tab="calendar">ปฏิทิน</div>
            <div class="nav-item" data-tab="reports">รายงาน</div>
            <div class="nav-item" data-tab="settings">ตั้งค่า</div>
        </div>

        <div class="calendar-full tab-content" id="calendar-full">
            <h2>ปฏิทิน Auditor</h2>
            <div class="full-calendar">
                <div class="full-calendar-header">
                    <div class="month-navigation">
                        <button class="nav-btn" id="prev-month"><i class="fas fa-chevron-left"></i></button>
                        <div class="current-month" id="current-month">มกราคม 2025</div>
                        <button class="nav-btn" id="next-month"><i class="fas fa-chevron-right"></i></button>
                    </div>
                </div>
                <div class="full-calendar-grid" id="full-calendar-grid">
                    <div class="full-calendar-header-day">อาทิตย์</div>
                    <div class="full-calendar-header-day">จันทร์</div>
                    <div class="full-calendar-header-day">อังคาร</div>
                    <div class="full-calendar-header-day">พุธ</div>
                    <div class="full-calendar-header-day">พฤหัส</div>
                    <div class="full-calendar-header-day">ศุกร์</div>
                    <div class="full-calendar-header-day">เสาร์</div>
                </div>
            </div>
        </div>
        
        <div class="tab-content" id="reports-tab" style="display:none;"></div>
        <div class="tab-content" id="settings-tab" style="display:none;"></div>


        <footer>
            <p>© 2025 ระบบจัดการตารางเวลาสำหรับ Auditor | พัฒนาเพื่อเพิ่มประสิทธิภาพในการทำงาน</p>
        </footer>
    </div>

    <div class="note-modal" id="note-modal">
        <div class="note-modal-content">
            <button class="close-modal" id="close-note-modal">&times;</button>
            <div class="note-modal-header">
                <h3>เพิ่ม Note สำหรับวันที่ <span class="selected-date" id="selected-date"></span></h3>
            </div>
            <textarea class="note-textarea" id="note-textarea" placeholder="กรุณากรอก note สำหรับวันนี้..."></textarea>
            <div class="note-actions">
                <button class="cancel-btn" id="cancel-note">ยกเลิก</button>
                <button class="save-note-btn" id="save-note">บันทึก</button>
            </div>
        </div>
    </div>

    <div class="report-password-modal" id="report-password-modal">
        <div class="report-password-modal-content">
            <button class="close-modal" id="close-report-password-modal">&times;</button>
            <div class="report-password-modal-header">
                <h3>ป้อนรหัสเพื่อดึงรายงาน</h3>
            </div>
            <div class="password-form">
                <p>กรุณากรอกรหัสผ่านเพื่อดึงรายงาน:</p>
                <input type="password" class="password-input" id="report-password-input" placeholder="ป้อนรหัส">
            </div>
            <div class="report-password-actions">
                <button class="cancel-btn" id="cancel-report-password">ยกเลิก</button>
                <button class="btn" id="confirm-report-password">ยืนยัน</button>
            </div>
        </div>
    </div>

    <div class="report-modal" id="report-modal">
        <div class="report-modal-content">
            <button class="close-modal" id="close-report-modal">&times;</button>
            <div class="report-modal-header">
                <h3>ดึงรายงาน Note รายเดือน</h3>
            </div>
            <div class="report-form">
                <div class="form-group">
                    <label for="report-month">เลือกเดือน:</label>
                    <select class="form-control" id="report-month">
                        <option value="0">มกราคม</option>
                        <option value="1">กุมภาพันธ์</option>
                        <option value="2">มีนาคม</option>
                        <option value="3">เมษายน</option>
                        <option value="4">พฤษภาคม</option>
                        <option value="5">มิถุนายน</option>
                        <option value="6">กรกฎาคม</option>
                        <option value="7">สิงหาคม</option>
