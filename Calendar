<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">a
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบจัดการตารางเวลาสำหรับ Auditor</title>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&family=TH+Sarabun+PSK:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Prompt', 'TH Sarabun PSK', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        header {
            text-align: center;
            padding: 40px 20px;
            color: white;
        }

        h1 {
            font-size: 2.8rem;
            margin-bottom: 15px;
            text-shadow: 0 2px 4px rgba(0,0,0,0.2);
        }

        .subtitle {
            font-size: 1.3rem;
            opacity: 0.9;
            max-width: 700px;
            margin: 0 auto;
            line-height: 1.6;
        }

        /* Navigation Menu */
        .navbar {
            background: rgba(255,255,255,0.15);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            padding: 15px 20px;
            margin: 20px 0;
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .nav-item {
            color: white;
            padding: 12px 25px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
            cursor: pointer;
            border: 2px solid transparent;
            font-size: 1.1rem;
        }

        .nav-item:hover {
            background: rgba(255,255,255,0.2);
            transform: translateY(-2px);
        }

        .nav-item.active {
            background: white;
            color: #667eea;
            font-weight: 600;
        }

        .calendar-full {
            background: white;
            border-radius: 15px;
            padding: 40px;
            margin-top: 50px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            display: block;
        }

        .calendar-full h2 {
            color: #333;
            margin-bottom: 30px;
            font-size: 2.2rem;
            text-align: center;
        }

        .full-calendar {
            margin-top: 20px;
        }

        .full-calendar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .month-navigation {
            display: flex;
            gap: 15px;
            align-items: center;
        }

        .nav-btn {
            background: #667eea;
            color: white;
            border: none;
            padding: 10px 15px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1rem;
            font-family: 'Prompt', 'TH Sarabun PSK', sans-serif;
        }

        .current-month {
            font-size: 1.5rem;
            font-weight: 600;
            color: #333;
        }

        .full-calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 5px;
        }

        .full-calendar-header-day {
            background: #667eea;
            color: white;
            padding: 15px;
            text-align: center;
            font-weight: 600;
            border-radius: 5px;
        }

        .full-calendar-day {
            background: #f8f9fa;
            padding: 15px;
            min-height: 80px;
            border-radius: 5px;
            border: 1px solid #e9ecef;
            cursor: pointer;
            transition: all 0.2s ease;
            position: relative;
        }

        .full-calendar-day:hover {
            background: #e3f2fd;
            border-color: #667eea;
        }

        .full-calendar-day.other-month {
            background: #f0f0f0;
            color: #999;
        }

        .full-calendar-day.today {
            background: #e3f2fd;
            border: 2px solid #667eea;
        }

        .full-calendar-day.holiday {
            background: #ffebee;
            border-color: #ffcdd2;
        }

        .day-date {
            font-weight: 600;
            margin-bottom: 5px;
        }

        .event-dot {
            width: 8px;
            height: 8px;
            background: #667eea;
            border-radius: 50%;
            display: inline-block;
            margin: 2px;
        }

        .holiday-mark {
            background: #f44336;
            color: white;
            padding: 2px 6px;
            border-radius: 10px;
            font-size: 0.7rem;
            display: inline-block;
            margin-top: 5px;
        }

        .day-events {
            font-size: 0.7rem;
            color: #666;
            margin-top: 3px;
            max-height: 30px;
            overflow: hidden;
        }

        footer {
            text-align: center;
            color: white;
            padding: 40px 20px;
            margin-top: 50px;
            font-size: 1.1rem;
        }

        /* Modal Styles */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.8);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background: white;
            border-radius: 15px;
            width: 90%;
            max-width: 1000px;
            max-height: 90vh;
            overflow: auto;
            position: relative;
            padding: 30px;
        }

        .close-modal {
            position: absolute;
            top: 20px;
            right: 20px;
            font-size: 2rem;
            cursor: pointer;
            color: #666;
            background: none;
            border: none;
        }

        .close-modal:hover {
            color: #f44336;
        }

        /* Note Modal */
        .note-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.8);
            z-index: 1100;
            justify-content: center;
            align-items: center;
        }

        .note-modal-content {
            background: white;
            border-radius: 15px;
            width: 90%;
            max-width: 500px;
            padding: 30px;
            position: relative;
        }

        .note-modal-header {
            margin-bottom: 20px;
        }

        .note-modal-header h3 {
            color: #333;
            font-size: 1.5rem;
        }

        .selected-date {
            color: #667eea;
            font-weight: 600;
        }

        .note-textarea {
            width: 100%;
            height: 150px;
            padding: 15px;
            border: 2px solid #e9ecef;
            border-radius: 10px;
            font-size: 1rem;
            resize: vertical;
            margin-bottom: 20px;
            font-family: 'Prompt', 'TH Sarabun PSK', sans-serif;
        }

        .note-textarea:focus {
            outline: none;
            border-color: #667eea;
        }

        .note-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .cancel-btn {
            background: #f5f5f5;
            color: #666;
            padding: 12px 25px;
            border-radius: 50px;
            border: none;
            cursor: pointer;
            font-weight: 600;
            font-family: 'Prompt', 'TH Sarabun PSK', sans-serif;
        }

        .save-note-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 12px 25px;
            border-radius: 50px;
            border: none;
            cursor: pointer;
            font-weight: 600;
            font-family: 'Prompt', 'TH Sarabun PSK', sans-serif;
        }

        /* Report Password Modal */
        .report-password-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.8);
            z-index: 1200;
            justify-content: center;
            align-items: center;
        }

        .report-password-modal-content {
            background: white;
            border-radius: 15px;
            width: 90%;
            max-width: 600px;
            padding: 30px;
            position: relative;
        }

        .report-password-modal-header {
            margin-bottom: 20px;
        }

        .report-password-modal-header h3 {
            color: #333;
            font-size: 1.5rem;
        }

        .password-form {
            margin-bottom: 20px;
        }

        .password-input {
            width: 100%;
            padding: 12px;
            border: 2px solid #e9ecef;
            border-radius: 10px;
            font-size: 1rem;
            font-family: 'Prompt', 'TH Sarabun PSK', sans-serif;
            text-align: center;
            letter-spacing: 5px;
        }

        .password-input:focus {
            outline: none;
            border-color: #667eea;
        }

        .report-password-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        /* Report Modal */
        .report-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.8);
            z-index: 1300;
            justify-content: center;
            align-items: center;
        }

        .report-modal-content {
            background: white;
            border-radius: 15px;
            width: 90%;
            max-width: 600px;
            padding: 30px;
            position: relative;
        }

        .report-modal-header {
            margin-bottom: 20px;
        }

        .report-modal-header h3 {
            color: #333;
            font-size: 1.5rem;
        }

        .report-form {
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
            color: #333;
        }

        .form-control {
            width: 100%;
            padding: 12px;
            border: 2px solid #e9ecef;
            border-radius: 10px;
            font-size: 1rem;
            font-family: 'Prompt', 'TH Sarabun PSK', sans-serif;
        }

        .form-control:focus {
            outline: none;
            border-color: #667eea;
        }

        .report-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .download-btn {
            background: linear-gradient(135deg, #4CAF50 0%, #2E7D32 100%);
            color: white;
            padding: 12px 25px;
            border-radius: 50px;
            border: none;
            cursor: pointer;
            font-weight: 600;
            font-family: 'Prompt', 'TH Sarabun PSK', sans-serif;
        }

        /* Settings Modal */
        .settings-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.8);
            z-index: 1400;
            justify-content: center;
            align-items: center;
        }

        .settings-modal-content {
            background: white;
            border-radius: 15px;
            width: 90%;
            max-width: 600px;
            padding: 30px;
            position: relative;
        }

        .settings-modal-header {
            margin-bottom: 20px;
        }

        .settings-modal-header h3 {
            color: #333;
            font-size: 1.5rem;
        }

        .settings-password-form {
            margin-bottom: 20px;
        }

        .settings-password-input {
            width: 100%;
            padding: 12px;
            border: 2px solid #e9ecef;
            border-radius: 10px;
            font-size: 1rem;
            font-family: 'Prompt', 'TH Sarabun PSK', sans-serif;
            text-align: center;
            letter-spacing: 5px;
        }

        .settings-password-input:focus {
            outline: none;
            border-color: #667eea;
        }

        .settings-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        /* Log Modal */
        .log-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.8);
            z-index: 1500;
            justify-content: center;
            align-items: center;
        }

        .log-modal-content {
            background: white;
            border-radius: 15px;
            width: 90%;
            max-width: 800px;
            max-height: 80vh;
            padding: 30px;
            position: relative;
            overflow: hidden;
        }

        .log-modal-header {
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .log-modal-header h3 {
            color: #333;
            font-size: 1.5rem;
        }

        .log-content {
            max-height: 60vh;
            overflow-y: auto;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 10px;
            font-family: monospace;
            font-size: 0.9rem;
        }

        .log-entry {
            margin-bottom: 10px;
            padding: 10px;
            border-bottom: 1px solid #eee;
        }

        .log-entry:last-child {
            border-bottom: none;
        }

        .log-timestamp {
            color: #667eea;
            font-weight: bold;
        }

        .log-action {
            color: #333;
        }

        .log-stats {
            background: #e3f2fd;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 20px;
            font-size: 0.9rem;
        }

        .log-stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-top: 10px;
        }

        .stat-item {
            background: white;
            padding: 10px;
            border-radius: 5px;
            text-align: center;
        }

        .stat-value {
            font-size: 1.2rem;
            font-weight: bold;
            color: #667eea;
        }

        .stat-label {
            font-size: 0.9rem;
            color: #666;
        }

        @media (max-width: 768px) {
            h1 {
                font-size: 2.2rem;
            }
            
            .subtitle {
                font-size: 1.1rem;
            }
            
            .navbar {
                flex-direction: column;
                align-items: center;
            }
            
            .nav-item {
                width: 90%;
                text-align: center;
            }
            
            .full-calendar-grid {
                grid-template-columns: repeat(7, 1fr);
                gap: 3px;
            }
            
            .full-calendar-day {
                padding: 8px;
                min-height: 60px;
                font-size: 0.9rem;
            }
        }

        @media (max-width: 480px) {
            .full-calendar-grid {
                grid-template-columns: repeat(7, 1fr);
                gap: 2px;
            }
            
            .full-calendar-day {
                padding: 5px;
                min-height: 50px;
                font-size: 0.8rem;
            }
            
            .day-date {
                font-size: 0.9rem;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>ระบบจัดการตารางเวลาสำหรับ Auditor</h1>
            <p class="subtitle">ใช้ Google Calendar / Outlook Calendar ที่แชร์ร่วมกัน เพื่อให้ Auditor สามารถบล็อกเวลาที่ไม่สะดวกล่วงหน้าได้ ทีมวางแผนจะได้เห็นภาพรวมและทำงานง่ายขึ้น</p>
        </header>

        <!-- Navigation Menu -->
        <div class="navbar">
            <div class="nav-item active" data-tab="calendar">ปฏิทิน</div>
            <div class="nav-item" data-tab="reports">รายงาน</div>
            <div class="nav-item" data-tab="settings">ตั้งค่า</div>
        </div>

        <!-- ปฏิทินแบบเต็ม -->
        <div class="calendar-full" id="calendar-full">
            <h2>ปฏิทินแบบเต็ม</h2>
            <div class="full-calendar">
                <div class="full-calendar-header">
                    <div class="month-navigation">
                        <button class="nav-btn" id="prev-month"><i class="fas fa-chevron-left"></i></button>
                        <div class="current-month" id="current-month">มกราคม 2025</div>
                        <button class="nav-btn" id="next-month"><i class="fas fa-chevron-right"></i></button>
                    </div>
                </div>
                <div class="full-calendar-grid" id="full-calendar-grid">
                    <!-- ปฏิทินจะถูกสร้างด้วย JavaScript -->
                </div>
            </div>
        </div>

        <footer>
            <p>© 2025 ระบบจัดการตารางเวลาสำหรับ Auditor | พัฒนาเพื่อเพิ่มประสิทธิภาพในการทำงาน</p>
        </footer>
    </div>

    <!-- Modal สำหรับเพิ่ม Note -->
    <div class="note-modal" id="note-modal">
        <div class="note-modal-content">
            <button class="close-modal" id="close-note-modal">&times;</button>
            <div class="note-modal-header">
                <h3>เพิ่ม Note สำหรับวันที่ <span class="selected-date" id="selected-date"></span></h3>
            </div>
            <textarea class="note-textarea" id="note-textarea" placeholder="กรุณากรอก note สำหรับวันนี้..."></textarea>
            <div class="note-actions">
                <button class="cancel-btn" id="cancel-note">ยกเลิก</button>
                <button class="save-note-btn" id="save-note">บันทึก</button>
            </div>
        </div>
    </div>

    <!-- Modal สำหรับป้อนรหัสก่อนดึงรายงาน -->
    <div class="report-password-modal" id="report-password-modal">
        <div class="report-password-modal-content">
            <button class="close-modal" id="close-report-password-modal">&times;</button>
            <div class="report-password-modal-header">
                <h3>ป้อนรหัสเพื่อดึงรายงาน</h3>
            </div>
            <div class="password-form">
                <p>กรุณากรอกรหัสผ่านเพื่อดึงรายงาน:</p>
                <input type="password" class="password-input" id="report-password-input" placeholder="ป้อนรหัส">
            </div>
            <div class="report-password-actions">
                <button class="cancel-btn" id="cancel-report-password">ยกเลิก</button>
                <button class="btn" id="confirm-report-password">ยืนยัน</button>
            </div>
        </div>
    </div>

    <!-- Modal สำหรับรายงาน -->
    <div class="report-modal" id="report-modal">
        <div class="report-modal-content">
            <button class="close-modal" id="close-report-modal">&times;</button>
            <div class="report-modal-header">
                <h3>ดึงรายงาน Note รายเดือน</h3>
            </div>
            <div class="report-form">
                <div class="form-group">
                    <label for="report-month">เลือกเดือน:</label>
                    <select class="form-control" id="report-month">
                        <option value="0">มกราคม</option>
                        <option value="1">กุมภาพันธ์</option>
                        <option value="2">มีนาคม</option>
                        <option value="3">เมษายน</option>
                        <option value="4">พฤษภาคม</option>
                        <option value="5">มิถุนายน</option>
                        <option value="6">กรกฎาคม</option>
                        <option value="7">สิงหาคม</option>
                        <option value="8">กันยายน</option>
                        <option value="9">ตุลาคม</option>
                        <option value="10">พฤศจิกายน</option>
                        <option value="11">ธันวาคม</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="report-year">เลือกปี:</label>
                    <select class="form-control" id="report-year">
                        <!-- Options will be generated by JavaScript -->
                    </select>
                </div>
            </div>
            <div class="report-actions">
                <button class="cancel-btn" id="cancel-report">ยกเลิก</button>
                <button class="download-btn" id="download-report">ดาวน์โหลด CSV</button>
            </div>
        </div>
    </div>

    <!-- Modal สำหรับตั้งค่า -->
    <div class="settings-modal" id="settings-modal">
        <div class="settings-modal-content">
            <button class="close-modal" id="close-settings-modal">&times;</button>
            <div class="settings-modal-header">
                <h3>ตั้งค่าระบบ</h3>
            </div>
            <div class="settings-password-form">
                <p>กรุณากรอกรหัสผ่านเพื่อเข้าถึง Log การบันทึก:</p>
                <input type="password" class="settings-password-input" id="settings-password-input" placeholder="ป้อนรหัส">
            </div>
            <div class="settings-actions">
                <button class="cancel-btn" id="cancel-settings">ยกเลิก</button>
                <button class="btn" id="access-log">เข้าถึง Log</button>
            </div>
        </div>
    </div>

    <!-- Modal สำหรับแสดง Log -->
    <div class="log-modal" id="log-modal">
        <div class="log-modal-content">
            <button class="close-modal" id="close-log-modal">&times;</button>
            <div class="log-modal-header">
                <h3>Log การบันทึก</h3>
            </div>
            <div class="log-stats" id="log-stats">
                <strong>สถิติการใช้งานระบบ:</strong>
                <div class="log-stats-grid">
                    <div class="stat-item">
                        <div class="stat-value" id="total-logs">0</div>
                        <div class="stat-label">รายการ Log ทั้งหมด</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value" id="storage-size">0 GB</div>
                        <div class="stat-label">ขนาดข้อมูล</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value" id="active-users">0</div>
                        <div class="stat-label">ผู้ใช้งาน</div>
                    </div>
                </div>
            </div>
            <div class="log-content" id="log-content">
                <!-- Log entries will be generated here -->
            </div>
        </div>
    </div>

    <script>
        // Navigation Menu Functionality
        document.querySelectorAll('.nav-item').forEach(item => {
            item.addEventListener('click', function() {
                // Remove active class from all items
                document.querySelectorAll('.nav-item').forEach(nav => {
                    nav.classList.remove('active');
                });
                
                // Add active class to clicked item
                this.classList.add('active');
                
                // Tab switching logic
                const tab = this.dataset.tab;
                const calendarFull = document.getElementById('calendar-full');
                
                if (tab === 'calendar') {
                    calendarFull.style.display = 'block';
                } else {
                    calendarFull.style.display = 'none';
                }
                
                if (tab === 'reports') {
                    openReportPasswordModal();
                } else if (tab === 'settings') {
                    openSettingsModal();
                }
                
                console.log(`Switched to ${tab} tab`);
            });
        });

        // ฟังก์ชันสำหรับ Note Modal
        const noteModal = document.getElementById('note-modal');
        const closeNoteModalBtn = document.getElementById('close-note-modal');
        const cancelNoteBtn = document.getElementById('cancel-note');
        const saveNoteBtn = document.getElementById('save-note');
        const noteTextarea = document.getElementById('note-textarea');
        const selectedDateElement = document.getElementById('selected-date');

        // ฟังก์ชันสำหรับ Report Password Modal
        const reportPasswordModal = document.getElementById('report-password-modal');
        const closeReportPasswordModalBtn = document.getElementById('close-report-password-modal');
        const cancelReportPasswordBtn = document.getElementById('cancel-report-password');
        const confirmReportPasswordBtn = document.getElementById('confirm-report-password');
        const reportPasswordInput = document.getElementById('report-password-input');

        // ฟังก์ชันสำหรับ Report Modal
        const reportModal = document.getElementById('report-modal');
        const closeReportModalBtn = document.getElementById('close-report-modal');
        const cancelReportBtn = document.getElementById('cancel-report');
        const downloadReportBtn = document.getElementById('download-report');
        const reportMonthSelect = document.getElementById('report-month');
        const reportYearSelect = document.getElementById('report-year');

        // ฟังก์ชันสำหรับ Settings Modal
        const settingsModal = document.getElementById('settings-modal');
        const closeSettingsModalBtn = document.getElementById('close-settings-modal');
        const cancelSettingsBtn = document.getElementById('cancel-settings');
        const accessLogBtn = document.getElementById('access-log');
        const settingsPasswordInput = document.getElementById('settings-password-input');

        // ฟังก์ชันสำหรับ Log Modal
        const logModal = document.getElementById('log-modal');
        const closeLogModalBtn = document.getElementById('close-log-modal');
        const logContent = document.getElementById('log-content');
        const totalLogsElement = document.getElementById('total-logs');
        const storageSizeElement = document.getElementById('storage-size');
        const activeUsersElement = document.getElementById('active-users');

        // ฟังก์ชันสำหรับปฏิทิน
        const fullCalendarGrid = document.getElementById('full-calendar-grid');
        const currentMonthElement = document.getElementById('current-month');
        const prevMonthBtn = document.getElementById('prev-month');
        const nextMonthBtn = document.getElementById('next-month');

        // ตั้งค่าวันที่ปัจจุบัน
        let currentDate = new Date();
        let currentMonth = currentDate.getMonth();
        let currentYear = currentDate.getFullYear();
        let selectedDate = null;
        let notes = {}; // เก็บ note ของแต่ละวัน
        let logs = []; // เก็บ log การบันทึก

        // ชื่อเดือนภาษาไทย
        const thaiMonths = [
            'มกราคม', 'กุมภาพันธ์', 'มีนาคม', 'เมษายน', 'พฤษภาคม', 'มิถุนายน',
            'กรกฎาคม', 'สิงหาคม', 'กันยายน', 'ตุลาคม', 'พฤศจิกายน', 'ธันวาคม'
        ];

        // ชื่อวันภาษาไทย
        const thaiDays = ['อา', 'จ', 'อ', 'พ', 'พฤ', 'ศ', 'ส'];

        // วันหยุดราชการประจำปี (ปี 2025)
        const regularHolidays = {
            '2025-01-01': 'วันขึ้นปีใหม่',
            '2025-02-03': 'วันมาฆบูชา',
            '2025-04-06': 'วันจักรี',
            '2025-04-13': 'วันสงกรานต์',
            '2025-04-14': 'วันสงกรานต์',
            '2025-04-15': 'วันสงกรานต์',
            '2025-05-01': 'วันแรงงานแห่งชาติ',
            '2025-05-05': 'วันฉัตรมงคล',
            '2025-05-19': 'วันพืชมงคล',
            '2025-06-02': 'วันเฉลิมพระชนมพรรษา พระบาทสมเด็จพระเจ้าอยู่หัว',
            '2025-07-28': 'วันเฉลิมพระชนมพรรษา พระบรมราชินี',
            '2025-08-12': 'วันเฉลิมพระชนมพรรษา พระบรมราชินีนาถ (วันแม่)',
            '2025-10-13': 'วันคล้ายวันสวรรคต พระบาทสมเด็จพระบรมชนกาธิเบศร มหาภูมิพลอดุลยเดชมหาราช บรมนาถบพิตร',
            '2025-10-23': 'วันปิยมหาราช',
            '2025-12-05': 'วันคล้ายวันเฉลิมพระชนมพรรษา พระบาทสมเด็จพระบรมชนกาธิเบศร มหาภูมิพลอดุลยเดชมหาราช บรมนาถบพิตร (วันพ่อ)',
            '2025-12-10': 'วันรัฐธรรมนูญ',
            '2025-12-31': 'วันสิ้นปี'
        };

        // วันหยุดราชการเฉพาะกิจ (ปี 2025)
        const specialHolidays = {
            '2025-02-14': 'วันวาเลนไทน์',
            '2025-07-15': 'วันเฉลิมพระชนมพรรษา พระบาทสมเด็จพระเจ้าอยู่หัว (กรณีพิเศษ)'
        };

        // ฟังก์ชันเพิ่ม log
        function addLog(action) {
            const now = new Date();
            const timestamp = now.toLocaleString('th-TH', {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit'
            });
            
            // ดึง User Agent
            const userAgent = navigator.userAgent;
            
            logs.push({ 
                timestamp, 
                action, 
                userAgent,
                id: logs.length + 1
            });
        }

        // ฟังก์ชันคำนวณขนาดข้อมูล (ประมาณการ)
        function calculateStorageSize() {
            // ประมาณการขนาดข้อมูล log (bytes)
            const logSize = logs.length * 200; // ประมาณ 200 bytes ต่อ log entry
            const notesSize = JSON.stringify(notes).length;
            const holidaysSize = JSON.stringify(regularHolidays).length + JSON.stringify(specialHolidays).length;
            
            const totalSize = logSize + notesSize + holidaysSize;
            const sizeInGB = (totalSize / (1024 * 1024 * 1024)).toFixed(2);
            
            return {
                size: totalSize,
                sizeInGB: sizeInGB,
                sizeInMB: (totalSize / (1024 * 1024)).toFixed(2)
            };
        }

        // ฟังก์ชันอัปเดตสถิติ
        function updateLogStats() {
            totalLogsElement.textContent = logs.length;
            
            const storageInfo = calculateStorageSize();
            storageSizeElement.textContent = `${storageInfo.sizeInGB} GB`;
            
            // นับผู้ใช้งาน (จาก User Agent ที่ไม่ซ้ำกัน)
            const uniqueUserAgents = [...new Set(logs.map(log => log.userAgent))];
            activeUsersElement.textContent = uniqueUserAgents.length;
        }

        // สร้าง options สำหรับปีใน report modal
        function generateYearOptions() {
            const currentYear = new Date().getFullYear();
            for (let year = currentYear; year <= currentYear + 5; year++) {
                const option = document.createElement('option');
                option.value = year;
                option.textContent = year;
                reportYearSelect.appendChild(option);
            }
            reportYearSelect.value = currentYear;
        }

        // ฟังก์ชันสร้างปฏิทิน
        function generateCalendar(month, year) {
            // อัปเดตชื่อเดือน
            currentMonthElement.textContent = `${thaiMonths[month]} ${year + 543}`;
            
            // ล้างปฏิทินเก่า
            fullCalendarGrid.innerHTML = '';
            
            // เพิ่มหัวตาราง
            thaiDays.forEach(day => {
                const headerDay = document.createElement('div');
                headerDay.className = 'full-calendar-header-day';
                headerDay.textContent = day;
                fullCalendarGrid.appendChild(headerDay);
            });
            
            // หาวันแรกของเดือน
            const firstDay = new Date(year, month, 1).getDay();
            // หาจำนวนวันในเดือน
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            // หาจำนวนวันในเดือนก่อนหน้า
            const daysInPrevMonth = new Date(year, month, 0).getDate();
            
            // เพิ่มวันจากเดือนก่อนหน้า
            for (let i = firstDay - 1; i >= 0; i--) {
                const dayElement = document.createElement('div');
                dayElement.className = 'full-calendar-day other-month';
                const prevMonthDate = new Date(year, month - 1, daysInPrevMonth - i);
                const dateStr = formatDate(prevMonthDate);
                dayElement.innerHTML = `
                    <div class="day-date">${daysInPrevMonth - i}</div>
                `;
                dayElement.dataset.date = dateStr;
                fullCalendarGrid.appendChild(dayElement);
            }
            
            // เพิ่มวันในเดือนปัจจุบัน
            const today = new Date();
            for (let i = 1; i <= daysInMonth; i++) {
                const dayElement = document.createElement('div');
                dayElement.className = 'full-calendar-day';
                
                const currentDateObj = new Date(year, month, i);
                const dateStr = formatDate(currentDateObj);
                
                // ตรวจสอบว่าวันนี้คือวันปัจจุบันหรือไม่
                if (i === today.getDate() && month === today.getMonth() && year === today.getFullYear()) {
                    dayElement.classList.add('today');
                }
                
                // ตรวจสอบว่าวันนี้เป็นวันหยุดราชการหรือไม่
                let holidayHtml = '';
                if (regularHolidays[dateStr]) {
                    dayElement.classList.add('holiday');
                    holidayHtml = `<div class="holiday-mark">${regularHolidays[dateStr]}</div>`;
                } else if (specialHolidays[dateStr]) {
                    dayElement.classList.add('holiday');
                    holidayHtml = `<div class="holiday-mark">${specialHolidays[dateStr]}</div>`;
                }
                
                // เพิ่มตัวอย่างเหตุการณ์
                let eventsHtml = '';
                if (i === 1 || i === 8 || i === 12 || i === 20) {
                    eventsHtml = '<div class="event-dot" title="ประชุมทีม"></div>';
                } else if (i === 5 || i === 18 || i === 25) {
                    eventsHtml = '<div class="event-dot" title="ตรวจสอบเอกสาร"></div>';
                }
                
                // เพิ่ม note ถ้ามี
                let noteHtml = '';
                if (notes[dateStr]) {
                    noteHtml = `<div class="day-events">${notes[dateStr]}</div>`;
                }
                
                dayElement.innerHTML = `
                    <div class="day-date">${i}</div>
                    ${holidayHtml}
                    ${eventsHtml}
                    ${noteHtml}
                `;
                dayElement.dataset.date = dateStr;
                fullCalendarGrid.appendChild(dayElement);
            }
            
            // คำนวณจำนวนช่องที่ต้องเพิ่มจากเดือนถัดไป
            const totalCells = 42; // 6 แถว x 7 คอลัมน์
            const remainingCells = totalCells - (firstDay + daysInMonth);
            
            // เพิ่มวันจากเดือนถัดไป
            for (let i = 1; i <= remainingCells; i++) {
                const dayElement = document.createElement('div');
                dayElement.className = 'full-calendar-day other-month';
                const nextMonthDate = new Date(year, month + 1, i);
                const dateStr = formatDate(nextMonthDate);
                dayElement.innerHTML = `
                    <div class="day-date">${i}</div>
                `;
                dayElement.dataset.date = dateStr;
                fullCalendarGrid.appendChild(dayElement);
            }
            
            // เพิ่ม event listener ให้กับแต่ละวัน
            document.querySelectorAll('.full-calendar-day').forEach(day => {
                day.addEventListener('click', function() {
                    const date = this.dataset.date;
                    openNoteModal(date);
                });
            });
        }

        // ฟังก์ชันจัดรูปแบบวันที่
        function formatDate(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        // ฟังก์ชันเปิด Note Modal
        function openNoteModal(date) {
            selectedDate = date;
            const dateObj = new Date(date);
            const formattedDate = `${dateObj.getDate()} ${thaiMonths[dateObj.getMonth()]} ${dateObj.getFullYear() + 543}`;
            selectedDateElement.textContent = formattedDate;
            noteTextarea.value = notes[date] || '';
            noteModal.style.display = 'flex';
        }

        // ฟังก์ชันปิด Note Modal
        function closeNoteModal() {
            noteModal.style.display = 'none';
            selectedDate = null;
        }

        // ฟังก์ชันบันทึก Note
        function saveNote() {
            if (selectedDate) {
                const note = noteTextarea.value.trim();
                if (note) {
                    notes[selectedDate] = note;
                    addLog(`บันทึก Note วันที่ ${selectedDate}: ${note}`);
                } else {
                    delete notes[selectedDate];
                    addLog(`ลบ Note วันที่ ${selectedDate}`);
                }
                closeNoteModal();
                generateCalendar(currentMonth, currentYear); // อัปเดตปฏิทิน
                updateLogStats(); // อัปเดตสถิติ
            }
        }

        // ฟังก์ชันเปิด Report Password Modal
        function openReportPasswordModal() {
            reportPasswordModal.style.display = 'flex';
            reportPasswordInput.value = '';
        }

        // ฟังก์ชันปิด Report Password Modal
        function closeReportPasswordModal() {
            reportPasswordModal.style.display = 'none';
        }

        // ฟังก์ชันเปิด Report Modal
        function openReportModal() {
            reportModal.style.display = 'flex';
        }

        // ฟังก์ชันปิด Report Modal
        function closeReportModal() {
            reportModal.style.display = 'none';
        }

        // ฟังก์ชันเปิด Settings Modal
        function openSettingsModal() {
            settingsModal.style.display = 'flex';
            settingsPasswordInput.value = '';
        }

        // ฟังก์ชันปิด Settings Modal
        function closeSettingsModal() {
            settingsModal.style.display = 'none';
        }

        // ฟังก์ชันเปิด Log Modal
        function openLogModal() {
            logModal.style.display = 'flex';
            displayLogs();
            updateLogStats();
        }

        // ฟังก์ชันปิด Log Modal
        function closeLogModal() {
            logModal.style.display = 'none';
        }

        // ฟังก์ชันแสดง Log
        function displayLogs() {
            logContent.innerHTML = '';
            if (logs.length === 0) {
                logContent.innerHTML = '<div class="log-entry">ไม่มีข้อมูล log</div>';
                return;
            }
            
            // แสดง log ย้อนหลัง 50 รายการล่าสุด
            const recentLogs = logs.slice(-50).reverse();
            recentLogs.forEach(log => {
                const logEntry = document.createElement('div');
                logEntry.className = 'log-entry';
                logEntry.innerHTML = `
                    <span class="log-timestamp">[${log.timestamp}]</span>
                    <span class="log-action">${log.action}</span>
                `;
                logContent.appendChild(logEntry);
            });
        }

        // ฟังก์ชันสร้าง CSV พร้อมรองรับภาษาไทย
        function generateCSV(month, year) {
            // หาจำนวนวันในเดือน
            const daysInMonth = new Date(year, parseInt(month) + 1, 0).getDate();
            
            // สร้าง header ของ CSV ด้วย BOM สำหรับรองรับ UTF-8
            let csvContent = '\uFEFF'; // UTF-8 BOM
            csvContent += "วันที่,Note,วันหยุดราชการ\n";
            
            // เพิ่มข้อมูลแต่ละวัน
            for (let i = 1; i <= daysInMonth; i++) {
                const dateStr = `${year}-${String(parseInt(month) + 1).padStart(2, '0')}-${String(i).padStart(2, '0')}`;
                const note = notes[dateStr] || '';
                const formattedDate = `${i}/${parseInt(month) + 1}/${year}`;
                
                // ตรวจสอบว่าวันนี้เป็นวันหยุดราชการหรือไม่
                let holidayInfo = '';
                if (regularHolidays[dateStr]) {
                    holidayInfo = regularHolidays[dateStr];
                } else if (specialHolidays[dateStr]) {
                    holidayInfo = specialHolidays[dateStr];
                }
                
                // Escape ข้อความสำหรับ CSV
                const escapedNote = note.replace(/"/g, '""');
                const escapedHoliday = holidayInfo.replace(/"/g, '""');
                csvContent += `"${formattedDate}","${escapedNote}","${escapedHoliday}"\n`;
            }
            
            return csvContent;
        }

        // ฟังก์ชันดาวน์โหลด CSV
        function downloadCSV() {
            const month = reportMonthSelect.value;
            const year = reportYearSelect.value;
            const csvContent = generateCSV(month, year);
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.setAttribute('href', url);
            link.setAttribute('download', `รายงาน_note_${thaiMonths[month]}_${year}.csv`);
            link.style.visibility = 'hidden';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            addLog(`ดาวน์โหลดรายงาน CSV ประจำเดือน ${thaiMonths[month]} ปี ${year}`);
            updateLogStats();
        }

        // นำทางเดือน
        prevMonthBtn.addEventListener('click', () => {
            currentMonth--;
            if (currentMonth < 0) {
                currentMonth = 11;
                currentYear--;
            }
            generateCalendar(currentMonth, currentYear);
        });

        nextMonthBtn.addEventListener('click', () => {
            currentMonth++;
            if (currentMonth > 11) {
                currentMonth = 0;
                currentYear++;
            }
            generateCalendar(currentMonth, currentYear);
        });

        // ปิด modal ด้วยปุ่ม ESC
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                if (noteModal.style.display === 'flex') {
                    closeNoteModal();
                } else if (reportPasswordModal.style.display === 'flex') {
                    closeReportPasswordModal();
                } else if (reportModal.style.display === 'flex') {
                    closeReportModal();
                } else if (settingsModal.style.display === 'flex') {
                    closeSettingsModal();
                } else if (logModal.style.display === 'flex') {
                    closeLogModal();
                }
            }
        });

        // Event listeners สำหรับ Note Modal
        closeNoteModalBtn.addEventListener('click', closeNoteModal);
        cancelNoteBtn.addEventListener('click', closeNoteModal);
        saveNoteBtn.addEventListener('click', saveNote);

        // Event listeners สำหรับ Report Password Modal
        closeReportPasswordModalBtn.addEventListener('click', closeReportPasswordModal);
        cancelReportPasswordBtn.addEventListener('click', closeReportPasswordModal);
        confirmReportPasswordBtn.addEventListener('click', () => {
            if (reportPasswordInput.value === '#1234') {
                closeReportPasswordModal();
                openReportModal();
                addLog('เข้าถึงหน้ารายงาน');
            } else {
                alert('รหัสผ่านไม่ถูกต้อง');
            }
        });

        // Event listeners สำหรับ Report Modal
        closeReportModalBtn.addEventListener('click', closeReportModal);
        cancelReportBtn.addEventListener('click', closeReportModal);
        downloadReportBtn.addEventListener('click', downloadCSV);

        // Event listeners สำหรับ Settings Modal
        closeSettingsModalBtn.addEventListener('click', closeSettingsModal);
        cancelSettingsBtn.addEventListener('click', closeSettingsModal);
        accessLogBtn.addEventListener('click', () => {
            if (settingsPasswordInput.value === '#1234') {
                closeSettingsModal();
                openLogModal();
                addLog('เข้าถึง Log การบันทึก');
                updateLogStats();
            } else {
                alert('รหัสผ่านไม่ถูกต้อง');
            }
        });

        // Event listeners สำหรับ Log Modal
        closeLogModalBtn.addEventListener('click', closeLogModal);

        // ปิด Modal เมื่อคลิกนอก modal
        window.addEventListener('click', (event) => {
            if (event.target === noteModal) {
                closeNoteModal();
            } else if (event.target === reportPasswordModal) {
                closeReportPasswordModal();
            } else if (event.target === reportModal) {
                closeReportModal();
            } else if (event.target === settingsModal) {
                closeSettingsModal();
            } else if (event.target === logModal) {
                closeLogModal();
            }
        });

        // ตั้งค่าเริ่มต้นให้ report modal
        reportMonthSelect.value = currentMonth;
        generateYearOptions();
        
        // ตั้งค่าเริ่มต้นปฏิทินให้แสดงวันที่ปัจจุบัน
        document.getElementById('current-month').textContent = `${thaiMonths[currentMonth]} ${currentYear + 543}`;
        generateCalendar(currentMonth, currentYear);
        
        // เพิ่ม log ตัวอย่าง
        addLog('ระบบเริ่มทำงาน');
        addLog('เข้าสู่ระบบโดยผู้ใช้ admin');
        
        // จำลองการเพิ่ม log หลายรายการ
        for (let i = 0; i < 1000; i++) {
            const actions = [
                'เข้าถึงหน้าปฏิทิน',
                'บันทึก Note วันที่ 2025-01-01',
                'ดาวน์โหลดรายงาน CSV',
                'เข้าถึงหน้ารายงาน',
                'อัปเดตการตั้งค่าระบบ'
            ];
            const randomAction = actions[Math.floor(Math.random() * actions.length)];
            addLog(randomAction);
        }
        
        // แสดงขนาดข้อมูลเริ่มต้น
        updateLogStats();
    </script>
</body>
