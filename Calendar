        cancelReportPasswordBtn.addEventListener('click', closeReportPasswordModal);
        
        confirmReportPasswordBtn.addEventListener('click', function() {
            if (reportPasswordInput.value === REPORT_PASSWORD) {
                reportPasswordModal.style.display = 'none';
                openReportModal();
                reportPasswordInput.value = '';
            } else {
                alert('รหัสผ่านไม่ถูกต้อง');
                reportPasswordInput.value = '';
                addLog('พยายามเข้าถึงรายงาน: รหัสผ่านไม่ถูกต้อง');
            }
        });

        // 5. Report Modal Actions
        closeReportModalBtn.addEventListener('click', closeReportModal);
        cancelReportBtn.addEventListener('click', closeReportModal);
        
        downloadReportBtn.addEventListener('click', function() {
            const month = parseInt(reportMonthSelect.value);
            const year = parseInt(reportYearSelect.value);
            
            if (isNaN(month) || isNaN(year)) {
                alert('กรุณาเลือกเดือนและปีให้ถูกต้อง');
                return;
            }

            const monthPadded = String(month + 1).padStart(2, '0');
            const prefix = `${year}-${monthPadded}`;
            
            // กรอง Note เฉพาะเดือนที่เลือก
            const filteredNotes = Object.keys(notes)
                .filter(dateKey => dateKey.startsWith(prefix))
                .map(dateKey => ({
                    Date: dateKey,
                    Note: notes[dateKey].replace(/\n/g, ' | ') // แทนที่ขึ้นบรรทัดใหม่ด้วย |
                }));
                
            if (filteredNotes.length === 0) {
                alert(`ไม่พบ Note ในเดือน ${thaiMonths[month]} ปี ${year}`);
                addLog(`พยายามดาวน์โหลดรายงาน: ไม่พบข้อมูลในเดือน ${prefix}`);
                return;
            }
            
            const csv = convertToCSV(filteredNotes);
            const filename = `Auditor_Notes_Report_${thaiMonths[month]}_${year}.csv`;
            downloadCSV(csv, filename);
            addLog(`ดาวน์โหลดรายงาน CSV เดือน ${prefix} จำนวน ${filteredNotes.length} รายการ`);
            closeReportModal();
        });

        // 6. Settings Modal Actions
        closeSettingsModalBtn.addEventListener('click', closeSettingsModal);
        cancelSettingsBtn.addEventListener('click', closeSettingsModal);
        
        accessLogBtn.addEventListener('click', function() {
            if (settingsPasswordInput.value === SETTINGS_PASSWORD) {
                openLogModal();
                settingsPasswordInput.value = '';
            } else {
                alert('รหัสผ่านไม่ถูกต้อง');
                settingsPasswordInput.value = '';
                addLog('พยายามเข้าถึง Log: รหัสผ่านไม่ถูกต้อง');
            }
        });

        // 7. Log Modal Actions
        closeLogModalBtn.addEventListener('click', closeLogModal);

        // *** การเริ่มต้นระบบ ***
        addLog('เริ่มต้นระบบและโหลดข้อมูลจาก Local Storage');
        generateCalendar(currentMonth, currentYear);
        generateYearOptions(); // เรียกใช้ครั้งแรก
        
    </script>
</body>
</html>
